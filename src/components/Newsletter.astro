---
const inputClass = 'max-w-full border border-gray-400 bg-white p-1 md:w-[300px]';
---

<div class="mx-auto" data-newsletter>
  <div class="text-center">
    <h4 id="newsletter" class="m-0 pt-5 text-[30px]">Newsletter</h4>
    <p class="m-0">Rimani Aggiornato sulle novita di milano.dev</p>
    <small class="text-[80%]">(la piattaforma non i singoli eventi)</small>
  </div>

  <div class="flex justify-center pt-5">
    <form class="mb-[1.45rem]">
      <label class="block">
        <div class="text-[80%] font-bold">Nome</div>
        <input
          class={inputClass}
          name="first_name"
          required
          placeholder="Bob"
          type="text"
        />
      </label>
      <label class="mt-2 block">
        <div class="text-[80%] font-bold">Email</div>
        <input
          class={inputClass}
          name="email_address"
          required
          placeholder="unclebob@cleancode.com"
          type="email"
        />
      </label>
      <div class="mt-2">
        <button
          type="submit"
          class="cursor-pointer rounded bg-dark-bg px-2 py-1 text-sm text-light-text"
        >
          Registrami
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Mocked subscription: the original posted to Mailchimp.
  for (const root of document.querySelectorAll<HTMLElement>('[data-newsletter]')) {
    root.querySelector('form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      root.innerHTML =
        '<div class="mx-auto py-5 text-center">Grazie! controlla l\'email per confermare</div>';
    });
  }
</script>
